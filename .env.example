# Copy this file to ".env" and fill in your own values.
# Get these from https://developer.safaricom.co.ke after creating an app.
# NEVER commit your real .env file or share it in chat.

MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret

# Sandbox test shortcode is 174379. For production, this is your
# registered Paybill or Till number.
MPESA_SHORTCODE=174379

# Sandbox passkey is published on the Daraja docs page for the
# STK push test app. For production, Safaricom issues you one.
MPESA_PASSKEY=your_passkey

# "sandbox" while testing, "production" once you go live.
MPESA_ENV=sandbox

# Must be a public HTTPS URL that reaches this server's /api/callback route.
# e.g. https://your-app.onrender.com/api/callback
CALLBACK_URL=https://your-deployed-url.example.com/api/callback

PORT=3000
